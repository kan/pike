{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions (scoped to Pike's own webviews, not the browser tab's children -- see browser.rs)",
  "webviews": [
    "main",
    "project-*",
    "global-*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "window-state:default",
    "updater:default",
    "process:default",
    "notification:default"
  ]
}
