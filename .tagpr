# tagpr の設定（#529）。リリース PR を作り、マージされたらタグを打つ。
# 流れは .claude/skills/release/SKILL.md、設計の理由は .claude/rules/build.md の「リリース PR（tagpr）」。
[tagpr]
	releaseBranch = main
	vPrefix = true
	# 版の表記は 3 ファイルとも tagpr が書く（各ファイルで、今の版の文字列の最初の 1 か所）。
	# lockfile（Cargo.lock / package-lock.json）は tagpr が触らないので、postVersionCommand が
	# そろえる（#565）。マージ後のタグは先頭のファイルの版から決まるので、成果物の名前を
	# 決める tauri.conf.json を先頭に置く
	versionFile = src-tauri/tauri.conf.json,src-tauri/Cargo.toml,package.json
	postVersionCommand = node scripts/release-prepare.mjs
	# CHANGELOG は各 PR が `## [Unreleased]` に書く。tagpr の生成（PR タイトルの列挙）は使わない
	changelog = false
	# リリースは Release ワークフローの draft ジョブが作る。Immutable releases なので、
	# tagpr が公開まで進めると成果物を足せなくなる
	release = false
	# 機能の PR は issue と同じ enhancement のラベルで minor に上げる。無ければ patch
	minorLabels = enhancement
